# Copiar a .env. Nunca versionar .env.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
# Producción (detrás de un proxy o balanceador): cuántos proxies hay delante de la API. 0 = ninguno (local).
TRUST_PROXY=0
# Redirige http a https. Requiere TRUST_PROXY >= 1. Dejar en false para probar en local.
FORCE_HTTPS=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=gg_postulantes
DB_PASSWORD=cambiar-esta-clave
DB_NAME=gg_postulantes
# Solo desarrollo/mock: crea las tablas solas. En producción se usan migraciones (el arranque rechaza true).
DB_SYNCHRONIZE=true
# Carga zonas, ofertas y un admin de ejemplo al arrancar (solo fuera de producción).
SEED_ON_BOOT=true

JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
# Clave que hay que enviar para poder registrar un administrador nuevo.
ADMIN_REGISTRATION_KEY=cambiar-clave-de-alta-de-admins

UPLOAD_DIR=./uploads
# Cifrado de los CV guardados (AES-256-GCM). Vacía = sin cifrar: alcanza para probar en local.
# Obligatoria en producción. Generar con: openssl rand -base64 32  (si se pierde, los CV guardados no se recuperan).
CV_ENCRYPTION_KEY=
# Limpieza de CV subidos que nunca se asociaron a un postulante. Vacío = apagada en local y encendida en producción.
# CV_CLEANUP_ENABLED=
CV_ORPHAN_TTL_HOURS=24

# RENAPER (SID): apagado hasta tener credenciales. Ver docs/renaper-integracion.md
RENAPER_ENABLED=false
RENAPER_BASE_URL=
RENAPER_CLIENT_ID=
RENAPER_CLIENT_SECRET=
